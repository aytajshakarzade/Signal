# Copy this file to .env and add your own credentials. Never share .env.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Email: Gmail SMTP is attempted first; Resend is the backup provider.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
DEV_EMAIL_MODE=true

# Local testing: false avoids IP-based signup limits. Choose intentionally for production.
ONE_ACCOUNT_PER_IP=false

# Supabase Auth: use a server-only sb_secret_... or legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY_LEGACY=

# AI providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Public trend feed and platform data imports
TREND_RSS_URL=https://trends.google.com/trending/rss
APIFY_API_TOKEN=

# Optional Stripe billing (leave blank for local-only use)
STRIPE_SECRET_KEY=
STRIPE_PRICE_GO=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
